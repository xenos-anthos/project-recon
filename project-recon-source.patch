+  if (width === 0 || height === 0) return;
+  const ratio = Math.min(window.devicePixelRatio || 1, 3);
+  const scaledWidth = Math.round(width * ratio);
+  const scaledHeight = Math.round(height * ratio);
+  if (waveform.width !== scaledWidth) waveform.width = scaledWidth;
+  if (waveform.height !== scaledHeight) waveform.height = scaledHeight;
+  const context = waveform.getContext('2d');
+  if (!context) return;
+  context.setTransform(ratio, 0, 0, ratio, 0, 0);
+  context.clearRect(0, 0, width, height);
+  const colors = getComputedStyle(waveform);
+  const quiet = colors.getPropertyValue('--wave-quiet').trim() || '#B6B2E2';
+  const played = colors.getPropertyValue('--wave-played').trim() || '#2925D8';
+  const peaks = activeRender?.peaks;
+  if (!peaks?.length) {
+    context.fillStyle = quiet;
+    context.fillRect(0, Math.round(height / 2), width, 1);
+    return;
+  }
+  const barCount = Math.min(peaks.length, Math.floor(width / 3));
+  const spacing = width / barCount;
+  const barWidth = Math.max(1, spacing * 0.53);
+  const availableHeight = height * 0.92;
+  const audioDuration = Number.isFinite(audio.duration) ? audio.duration : activeRender.duration;
+  const progress = audioDuration > 0 ? audio.currentTime / audioDuration : 0;
+  for (let i = 0; i < barCount; i += 1) {
+    const start = Math.floor(i * peaks.length / barCount);
+    const end = Math.floor((i + 1) * peaks.length / barCount);
+    let peak = 0;
+    for (let j = start; j < end; j += 1) peak = Math.max(peak, peaks[j] || 0);
+    const barHeight = Math.max(2, Math.min(1, peak) * availableHeight);
+    context.fillStyle = (i + 0.5) / barCount <= progress ? played : quiet;
+    context.fillRect(i * spacing + (spacing - barWidth) / 2, (height - barHeight) / 2, barWidth, barHeight);
+  }
+}
+
+function syncPlayback() {
+  const audioDuration = Number.isFinite(audio.duration) ? audio.duration : activeRender?.duration || 0;
+  const time = audio.currentTime || 0;
