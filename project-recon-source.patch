diff --git a/dist/audio-recording.js b/dist/audio-recording.js
new file mode 100644
index 0000000000000000000000000000000000000000..3e01221f97a709d841c876d083426f7ec5f6ed4d
--- /dev/null
+++ b/dist/audio-recording.js
@@ -0,0 +1,43 @@
+const PEAK_COUNT = 120;
+
+export function makeRecording(chunks, sampleRate) {
+  const frames = chunks.reduce((total, { samples, silence }) => total + samples.length + silence, 0);
+  const wave = new ArrayBuffer(44 + frames * 2);
+  const view = new DataView(wave);
+  const peaks = Array(PEAK_COUNT).fill(0);
+
+  // 16-bit little-endian PCM, one channel, one continuous data chunk.
+  view.setUint32(0, 0x52494646); // RIFF
+  view.setUint32(4, wave.byteLength - 8, true);
+  view.setUint32(8, 0x57415645); // WAVE
+  view.setUint32(12, 0x666D7420); // fmt
+  view.setUint32(16, 16, true);
+  view.setUint16(20, 1, true);
+  view.setUint16(22, 1, true);
+  view.setUint32(24, sampleRate, true);
+  view.setUint32(28, sampleRate * 2, true);
+  view.setUint16(32, 2, true);
+  view.setUint16(34, 16, true);
+  view.setUint32(36, 0x64617461); // data
+  view.setUint32(40, frames * 2, true);
+
+  let index = 0;
+  for (const { samples, silence } of chunks) {
+    for (const sample of samples) {
+      const value = Number.isFinite(sample) ? Math.max(-1, Math.min(1, sample)) : 0;
+      const pcm = Math.round(value * (value < 0 ? 32768 : 32767));
+      view.setInt16(44 + index * 2, pcm, true);
+      const bin = Math.floor(index * PEAK_COUNT / frames);
+      peaks[bin] = Math.max(peaks[bin], Math.abs(pcm));
+      index += 1;
+    }
+    index += silence;
+  }
+
+  const loudest = Math.max(1, ...peaks);
+  return {
+    wav: new Blob([wave], { type: "audio/wav" }),
+    peaks: peaks.map((peak) => peak / loudest),
+    duration: frames / sampleRate,
+  };
+}
diff --git a/dist/cloud-sounds.js b/dist/cloud-sounds.js
new file mode 100644
index 0000000000000000000000000000000000000000..10c486480e6624c324eb261b8aa8b26ef6001f7b
--- /dev/null
+++ b/dist/cloud-sounds.js
@@ -0,0 +1,342 @@
+const MAX_SOUND_BYTES = 32 * 1024 * 1024;
+const WAV_HEADER_BYTES = 44;
+const SAMPLE_RATE = 24_000;
+const PEAK_COUNT = 120;
+const SOUND_ID = /^[\da-f]{8}-[\da-f]{4}-[1-8][\da-f]{3}-[89ab][\da-f]{3}-[\da-f]{12}$/;
+const SIGN_IN = '/signin-with-chatgpt?return_to=%2F%23history';
+const SIGN_OUT = '/signout-with-chatgpt?return_to=%2F';
+
+class CloudError extends Error {
+  constructor(message, status) {
+    super(message);
+    this.status = status;
+  }
+}
+
+function cloudFetch(path, options = {}) {
+  return fetch(path, { cache: 'no-store', credentials: 'same-origin', ...options });
+}
+
+async function expectSuccess(response) {
+  if (response.ok) return response;
+  const details = await response.json().catch(() => null);
+  throw new CloudError(details?.error || 'Cloud sounds are unavailable. Try again.', response.status);
+}
+
+function isSound(sound) {
+  return sound && SOUND_ID.test(sound.id) && typeof sound.title === 'string' &&
+    typeof sound.voiceLabel === 'string' && Number.isSafeInteger(sound.createdAt) &&
+    Math.abs(sound.createdAt) <= 8_640_000_000_000_000 && Number.isFinite(sound.speed) &&
+    Number.isFinite(sound.duration) && sound.duration > 0 && Number.isSafeInteger(sound.bytes) &&
+    sound.bytes > WAV_HEADER_BYTES && sound.bytes <= MAX_SOUND_BYTES;
+}
+
+export async function readCloudWaveform(wav) {
+  if (wav.size <= WAV_HEADER_BYTES || wav.size > MAX_SOUND_BYTES || wav.size % 2) {
+    throw new Error('This saved sound does not contain playable WAV audio.');
+  }
+  const bytes = new DataView(await wav.arrayBuffer());
+  const dataLength = wav.size - WAV_HEADER_BYTES;
+  if (bytes.getUint32(0) !== 0x52494646 || bytes.getUint32(4, true) !== wav.size - 8 ||
+      bytes.getUint32(8) !== 0x57415645 || bytes.getUint32(12) !== 0x666d7420 ||
+      bytes.getUint32(16, true) !== 16 || bytes.getUint16(20, true) !== 1 ||
+      bytes.getUint16(22, true) !== 1 || bytes.getUint32(24, true) !== SAMPLE_RATE ||
+      bytes.getUint32(28, true) !== SAMPLE_RATE * 2 || bytes.getUint16(32, true) !== 2 ||
+      bytes.getUint16(34, true) !== 16 || bytes.getUint32(36) !== 0x64617461 ||
+      bytes.getUint32(40, true) !== dataLength) {
+    throw new Error('This saved sound does not contain playable WAV audio.');
+  }
+  const frames = dataLength / 2;
+  const peaks = Array(PEAK_COUNT).fill(0);
+  for (let frame = 0; frame < frames; frame += 1) {
+    const sample = bytes.getInt16(WAV_HEADER_BYTES + frame * 2, true);
+    const bin = Math.floor(frame * PEAK_COUNT / frames);
+    peaks[bin] = Math.max(peaks[bin], Math.abs(sample));
+  }
+  const loudest = Math.max(1, ...peaks);
+  return { duration: frames / SAMPLE_RATE, peaks: peaks.map((peak) => peak / loudest) };
+}
+
+function recordingSummary(sound) {
+  const seconds = Math.floor(sound.duration);
+  const duration = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
+  const date = new Date(sound.createdAt).toLocaleString(undefined, {
+    month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
+  });
+  return `${sound.voiceLabel} Â· ${duration} Â· ${date}`;
+}
+
+function element(tag, className, content = '') {
+  const node = document.createElement(tag);
+  node.className = className;
+  node.textContent = content;
+  return node;
+}
+
+function downloadWav(wav, title) {
+  const url = URL.createObjectURL(wav);
+  const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-+|-+$)/g, '').slice(0, 56);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = `recon-${slug || 'sound'}.wav`;
+  document.body.append(link);
+  link.click();
+  link.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 30_000);
+}
+
+export function setupCloudSounds({ onOpen, onChange }) {
+  const byId = (id) => document.getElementById(id);
+  const account = byId('account-link');
+  const accountLabel = account.querySelector('[data-account-label]') || account;
+  const signIn = byId('cloud-sign-in');
+  const signOut = byId('cloud-sign-out');
+  const status = byId('cloud-status');
+  const list = byId('cloud-list');
+  const more = byId('cloud-more');
+  const sounds = new Map();
+  let supported = true;
+  let authenticated = false;
+  let scope = 0;
+  let nextCursor;
+  let paging = false;
+  let notificationQueued = false;
+
+  signIn.href = SIGN_IN;
+  signIn.target = '_top';
+  signOut.href = SIGN_OUT;
+  signOut.target = '_top';
+
+  function notifyChange() {
+    if (notificationQueued) return;
+    notificationQueued = true;
+    queueMicrotask(() => {
+      notificationQueued = false;
+      onChange?.();
+    });
+  }
+
+  function message(text, tone = 'neutral') {
+    status.textContent = text;
+    status.dataset.tone = tone;
+  }
+
+  function renderAccount() {
+    account.hidden = !supported;
+    accountLabel.textContent = authenticated ? 'Account' : 'Sign in';
+    account.href = authenticated ? '#history' : SIGN_IN;
+    if (authenticated) account.removeAttribute('target');
+    else account.target = '_top';
+    signIn.hidden = !supported || authenticated;
+    signOut.hidden = !authenticated;
+    more.hidden = !authenticated || !nextCursor;
+    more.disabled = paging;
+  }
+
+  function clearSession() {
+    scope += 1;
+    authenticated = false;
+    sounds.clear();
+    nextCursor = undefined;
+    paging = false;
+    list.replaceChildren();
+    renderAccount();
+    notifyChange();
+  }
+
+  function sessionError(error, version) {
+    if (version !== scope) return;
+    if (error.status === 401) {
+      clearSession();
+      message('Sign in to access your cloud sounds.');
+    } else {
+      message(error.message || 'Cloud sounds are unavailable. Try again.', 'error');
+    }
+  }
+
+  async function getWav(sound) {
+    const response = await expectSuccess(await cloudFetch(`/api/sounds/${sound.id}`));
+    if (!response.headers.get('Content-Type')?.toLowerCase().startsWith('audio/wav')) {
+      throw new CloudError('Sign in to access this saved sound.', 401);
+    }
+    const wav = await response.blob();
+    if (wav.size !== sound.bytes) throw new Error('The saved sound download was incomplete.');
+    return wav;
+  }
+
+  function renderSounds() {
+    const version = scope;
+    const rows = [...sounds.values()].sort((first, second) => second.createdAt - first.createdAt);
+    list.replaceChildren(...rows.map((sound) => {
+      const row = element('div', 'history-item');
+      const info = element('div', 'history-info');
+      info.append(
+        element('p', 'history-name', sound.title),
+        element('p', 'history-meta', recordingSummary(sound)),
+      );
+      const actions = element('div', 'history-actions');
+      function action(label, ariaLabel, perform) {
+        const button = element('button', 'compact-button', label);
+        button.type = 'button';
+        button.setAttribute('aria-label', ariaLabel);
+        button.addEventListener('click', async () => {
+          if (version !== scope || !authenticated || !sounds.has(sound.id)) return;
+          button.disabled = true;
+          try {
+            await perform();
+          } catch (error) {
+            sessionError(error, version);
+          } finally {
+            button.disabled = false;
+          }
+        });
+        actions.append(button);
+      }
+      action('Open', `Open cloud sound ${sound.title}`, async () => {
+        const wav = await getWav(sound);
+        if (version !== scope || !sounds.has(sound.id)) return;
+        const waveform = await readCloudWaveform(wav);
+        if (version === scope && sounds.has(sound.id)) onOpen({ ...sound, wav, ...waveform });
+      });
+      action('WAV', `Download cloud sound ${sound.title} as WAV`, async () => {
+        const wav = await getWav(sound);
+        if (version === scope && sounds.has(sound.id)) downloadWav(wav, sound.title);
+      });
+      action('Remove', `Remove cloud sound ${sound.title}`, async () => {
+        if (!window.confirm(`Remove â€œ${sound.title}â€ from your cloud sounds?`)) return;
+        const response = await expectSuccess(await cloudFetch(`/api/sounds/${sound.id}`, { method: 'DELETE' }));
+        if (response.status !== 204) throw new CloudError('Sign in to remove this saved sound.', 401);
+        if (version !== scope) return;
+        sounds.delete(sound.id);
+        renderSounds();
+        notifyChange();
+        message('Sound removed from the cloud.', 'success');
+      });
+      row.append(info, actions);
+      return row;
+    }));
+  }
+
+  async function loadPage(version, cursor) {
+    if (!authenticated || version !== scope || paging) return;
+    paging = true;
+    renderAccount();
+    message('Loading cloud soundsâ€¦');
+    try {
+      const path = cursor ? `/api/sounds?cursor=${encodeURIComponent(cursor)}` : '/api/sounds';
+      const response = await expectSuccess(await cloudFetch(path));
+      if (!response.headers.get('Content-Type')?.toLowerCase().includes('application/json')) {
+        throw new CloudError('Sign in to access your cloud sounds.', 401);
+      }
+      const page = await response.json();
+      if (!Array.isArray(page.sounds)) throw new Error('Cloud sounds could not be read.');
+      if (version !== scope) return;
+      for (const sound of page.sounds) if (isSound(sound)) sounds.set(sound.id, sound);
+      nextCursor = typeof page.nextCursor === 'string' && page.nextCursor !== cursor ? page.nextCursor : undefined;
+      renderSounds();
+      notifyChange();
+      message(sounds.size ? '' : 'Sounds you save to the cloud will appear here.');
+    } catch (error) {
+      sessionError(error, version);
+    } finally {
+      if (version === scope) {
+        paging = false;
+        renderAccount();
+      }
+    }
+  }
+
+  async function refresh() {
+    clearSession();
+    const version = scope;
+    message('Checking accountâ€¦');
+    try {
+      const response = await cloudFetch('/api/account');
+      if (version !== scope) return;
+      if (response.status === 401) {
+        supported = true;
+        renderAccount();
+        message('Sign in to save sounds across devices.');
+        return;
+      }
+      if (response.status === 404 ||
+          (response.ok && !response.headers.get('Content-Type')?.toLowerCase().includes('application/json'))) {
+        supported = false;
+        renderAccount();
+        message('Cloud sounds are available on hosted Project Recon.');
+        return;
+      }
+      const accountResponse = await expectSuccess(response);
+      const identity = await accountResponse.json();
+      if (version !== scope) return;
+      supported = true;
+      authenticated = identity.authenticated === true;
+      renderAccount();
+      notifyChange();
+      if (authenticated) await loadPage(version);
+      else message('Sign in to save sounds across devices.');
+    } catch (error) {
+      sessionError(error, version);
+    }
+  }
+
+  async function save(record) {
+    if (!authenticated) throw new CloudError('Sign in to save this sound to the cloud.', 401);
+    const { wav, id, title, voiceLabel, createdAt, speed } = record;
+    if (!SOUND_ID.test(id) || !(wav instanceof Blob) || wav.size <= WAV_HEADER_BYTES ||
+        wav.type !== 'audio/wav' || typeof title !== 'string' || !title.trim() || title.trim().length > 140 ||
+        !Number.isSafeInteger(createdAt) || createdAt < 0 || !Number.isFinite(speed) || speed < 0.5 || speed > 2) {
+      throw new Error('Choose a complete Project Recon recording to save.');
+    }
+    if (wav.size > MAX_SOUND_BYTES) throw new Error('Sounds can be up to 32 MiB.');
+    if (sounds.has(id)) return sounds.get(id);
+    const version = scope;
+    const metadata = {
+      title,
+      voiceLabel: typeof voiceLabel === 'string' && voiceLabel.trim() ? voiceLabel : 'Voice',
+      createdAt,
+      speed,
+    };
+    const options = {
+      method: 'PUT',
+      headers: {
+        'Content-Type': 'audio/wav',
+        'X-Recon-Sound': encodeURIComponent(JSON.stringify(metadata)),
+      },
+      body: wav,
+    };
+    try {
+      const path = `/api/sounds/${id}`;
+      const first = await cloudFetch(path, options).catch(() => null);
+      if (version !== scope) throw new Error('The cloud session changed. Sign in and try again.');
+      // The sound ID makes a retry safe even when the first response was lost.
+      const response = await expectSuccess(!first || first.status >= 500 ? await cloudFetch(path, options) : first);
+      if (!response.headers.get('Content-Type')?.toLowerCase().includes('application/json')) {
+        throw new CloudError('Sign in to save this sound to the cloud.', 401);
+      }
+      const { sound } = await response.json();
+      if (version !== scope) throw new Error('The cloud session changed. Sign in and try again.');
+      if (!isSound(sound) || sound.id !== id) throw new Error('The cloud could not confirm this save. Try again.');
+      sounds.set(id, sound);
+      renderSounds();
+      notifyChange();
+      message('Sound saved to the cloud.', 'success');
+      return sound;
+    } catch (error) {
+      sessionError(error, version);
+      throw error;
+    }
+  }
+
+  more.addEventListener('click', () => {
+    if (nextCursor) void loadPage(scope, nextCursor);
+  });
+  window.addEventListener('pagehide', (event) => {
+    if (event.persisted) clearSession();
+  });
+  window.addEventListener('pageshow', (event) => {
+    if (event.persisted) void refresh();
+  });
+  renderAccount();
+  return { refresh, save, isSaved: (id) => sounds.has(id), canSave: () => authenticated };
+}
diff --git a/dist/custom-voice-worker.js b/dist/custom-voice-worker.js
new file mode 100644
index 0000000000000000000000000000000000000000..2e20d95724327ff07eb316f80d65cabd7a12b0e9
--- /dev/null
+++ b/dist/custom-voice-worker.js
@@ -0,0 +1,35 @@
+import { makeRecording } from './audio-recording.js';
+
+self.addEventListener('message', async ({ data }) => {
+  const { id, text, voice } = data;
+  const progress = (message, percent) => self.postMessage({ id, type: 'progress', message, percent });
+  try {
+    if (typeof text !== 'string' || !/[\p{L}\p{N}]/u.test(text)) {
+      throw new Error('Add some text to generate speech.');
+    }
+    let audio;
+    if (voice?.type === 'design') {
+      const { synthesizeDesign } = await import('./voice-design-engine.js');
+      audio = await synthesizeDesign({ text, description: voice.description, progress });
+    } else if (voice?.type === 'clone') {
+      if (text.length > 6000) throw new Error('Keep the script within 6,000 characters.');
+      const { synthesizeClone } = await import('./voice-clone-engine.js');
+      audio = await synthesizeClone({ text, reference: voice.reference, progress });
+    } else {
+      throw new Error('Select a custom voice and try again.');
+    }
+    const { samples, sampleRate } = audio;
+    if (!(samples instanceof Float32Array) || !samples.length || sampleRate !== 24_000) {
+      throw new Error('The engine did not return playable audio.');
+    }
+    const result = makeRecording([{ samples, silence: 0 }], sampleRate);
+    self.postMessage({ id, type: 'result', ...result });
+  } catch (error) {
+    console.error('Custom voice generation failed', error);
+    self.postMessage({
+      id,
+      type: 'error',
+      message: error instanceof Error ? error.message : 'Voice generation failed. Try again.',
+    });
+  }
+});
diff --git a/dist/custom-voices.js b/dist/custom-voices.js
new file mode 100644
index 0000000000000000000000000000000000000000..9c7a1982b1af96a187f9ce3706de97ef382b2fb4
--- /dev/null
+++ b/dist/custom-voices.js
@@ -0,0 +1,319 @@
+const SAMPLE_RATE = 24_000;
+const PROFILE_LIMIT = 12;
+const REFERENCE_LIMIT_SECONDS = 10;
+const MIN_REFERENCE_SECONDS = 3;
+const MAX_FILE_SIZE = 20 * 1024 * 1024;
+
+async function decodeReference(file) {
+  if (file.size > MAX_FILE_SIZE) throw new Error('Choose an audio file smaller than 20 MB.');
+  const decoder = new OfflineAudioContext(1, 1, SAMPLE_RATE);
+  let audio;
+  try {
+    audio = await decoder.decodeAudioData(await file.arrayBuffer());
+  } catch {
+    throw new Error('This audio format could not be read. Try a WAV or MP3 file.');
+  }
+  if (audio.duration < MIN_REFERENCE_SECONDS) throw new Error('The recording needs at least 3 seconds of speech.');
+  const frames = Math.min(SAMPLE_RATE * REFERENCE_LIMIT_SECONDS, audio.length);
+  const mono = new Float32Array(frames);
+  for (let channel = 0; channel < audio.numberOfChannels; channel += 1) {
+    const samples = audio.getChannelData(channel);
+    for (let frame = 0; frame < frames; frame += 1) {
+      mono[frame] += samples[frame] / audio.numberOfChannels;
+    }
+  }
+  if (!mono.some((sample) => Math.abs(sample) > 0.003)) {
+    throw new Error('The recording is nearly silent. Choose a clip with clear speech.');
+  }
+  return mono;
+}
+
+export function generationLimit(profile) {
+  return profile?.type === 'design' ? 500 : 6000;
+}
+
+export function usesKokoro(profile) {
+  return !profile || profile.type === 'blend';
+}
+
+function element(tag, className, text) {
+  const item = document.createElement(tag);
+  if (className) item.className = className;
+  if (text) item.textContent = text;
+  return item;
+}
+
+function summarize(profile, voices) {
+  if (profile.type === 'design') return 'Voice from a description';
+  if (profile.type === 'clone') return 'Voice from your recording';
+  const second = Math.round(profile.ratio * 100);
+  return `${voices[profile.voiceA].name} ${100 - second}% Â· ${voices[profile.voiceB].name} ${second}%`;
+}
+
+export function setupCustomVoices({ voices, select, listProfiles, storeProfile, deleteProfile, onUse, onPreview, onCancel }) {
+  const byId = (id) => document.getElementById(id);
+  const form = byId('custom-form');
+  const name = byId('custom-name');
+  const description = byId('voice-description');
+  const voiceA = byId('blend-a');
+  const voiceB = byId('blend-b');
+  const ratio = byId('blend-ratio');
+  const mix = byId('blend-value');
+  const file = byId('voice-recording');
+  const fileStatus = byId('recording-status');
+  const ownVoice = byId('confirm-own-voice');
+  const save = byId('save-custom-voice');
+  const preview = byId('preview-custom-voice');
+  const cancel = byId('cancel-custom-preview');
+  const status = byId('custom-status');
+  const progress = byId('custom-progress');
+  const player = byId('custom-preview-player');
+  const empty = byId('custom-empty');
+  const list = byId('custom-list');
+  const methodPanels = Array.from(form.querySelectorAll('[data-method]'));
+  const controls = Array.from(form.querySelectorAll('input, textarea, select, button')).filter((control) => control !== cancel);
+  const options = element('optgroup');
+  options.label = 'Custom voices';
+  options.hidden = true;
+  select.append(options);
+
+  let profiles = [];
+  let busy = false;
+  let decoding = false;
+  let fileVersion = 0;
+  let reference;
+  let previewUrl;
+
+  for (const [id, voice] of Object.entries(voices)) {
+    for (const target of [voiceA, voiceB]) {
+      const option = element('option', '', `${voice.name} Â· ${voice.accent}`);
+      option.value = id;
+      target.append(option);
+    }
+  }
+  voiceB.value = 'am_michael';
+
+  function method() {
+    return form.elements.namedItem('voice-method').value;
+  }
+
+  function setStatus(message, tone = 'neutral') {
+    status.textContent = message;
+    status.dataset.tone = tone;
+  }
+
+  function updateProgress(message, percent) {
+    setStatus(message);
+    progress.hidden = false;
+    if (Number.isFinite(percent)) progress.value = Math.max(0, Math.min(100, percent));
+    else progress.removeAttribute('value');
+  }
+
+  function updateBusy(value, cancelable) {
+    busy = value;
+    for (const control of controls) control.disabled = busy;
+    preview.disabled = busy || (method() === 'clone' && decoding);
+    save.disabled = preview.disabled;
+    cancel.hidden = !cancelable;
+    if (!cancelable) {
+      progress.hidden = true;
+      progress.removeAttribute('value');
+    }
+    for (const action of list.querySelectorAll('button')) action.disabled = busy;
+  }
+
+  function stopPreview(clear = false) {
+    player.pause();
+    if (clear && previewUrl) {
+      player.removeAttribute('src');
+      player.load();
+      URL.revokeObjectURL(previewUrl);
+      previewUrl = undefined;
+      player.hidden = true;
+    }
+  }
+
+  function showPreview(recording) {
+    stopPreview(true);
+    previewUrl = URL.createObjectURL(recording);
+    player.src = previewUrl;
+    player.hidden = false;
+    setStatus('Preview ready. Press play to listen.', 'success');
+  }
+
+  function getProfile(id) {
+    return profiles.find((profile) => profile.id === id);
+  }
+
+  function renderProfiles() {
+    const selected = select.value;
+    options.replaceChildren(...profiles.map((profile) => {
+      const option = element('option', '', profile.name);
+      option.value = profile.id;
+      return option;
+    }));
+    options.hidden = profiles.length === 0;
+    if (getProfile(selected) || Object.hasOwn(voices, selected)) select.value = selected;
+    else select.value = 'af_heart';
+    const rows = profiles.map((profile) => {
+      const row = element('div', 'voice-item');
+      const info = element('div', 'voice-info');
+      info.append(element('p', 'voice-name', profile.name), element('p', 'voice-subtitle', summarize(profile, voices)));
+      const actions = element('div', 'history-actions');
+      const use = element('button', 'compact-button', 'Use');
+      use.type = 'button';
+      use.disabled = busy;
+      use.setAttribute('aria-label', `Use ${profile.name}`);
+      use.addEventListener('click', () => onUse(profile.id));
+      const remove = element('button', 'compact-button', 'Delete');
+      remove.type = 'button';
+      remove.disabled = busy;
+      remove.setAttribute('aria-label', `Delete ${profile.name}`);
+      remove.addEventListener('click', async () => {
+        if (!window.confirm(`Delete the saved voice â€œ${profile.name}â€ from this browser?`)) return;
+        const wasSelected = select.value === profile.id;
+        try {
+          if (profile.persisted) await deleteProfile(profile.id);
+          profiles = profiles.filter((item) => item.id !== profile.id);
+          renderProfiles();
+          setStatus('Saved voice deleted.', 'success');
+          if (wasSelected) select.dispatchEvent(new Event('change'));
+        } catch {
+          setStatus('The saved voice could not be removed. Refresh and try again.', 'error');
+        }
+      });
+      actions.append(use, remove);
+      row.append(info, actions);
+      return row;
+    });
+    list.replaceChildren(...rows);
+    empty.hidden = profiles.length > 0;
+  }
+
+  const initialized = listProfiles()
+    .then((saved) => {
+      profiles = saved.sort((first, second) => second.createdAt - first.createdAt);
+      renderProfiles();
+    })
+    .catch(() => {});
+
+  function draft({ requireName }) {
+    const voiceName = name.value.trim();
+    if (requireName && !voiceName) {
+      name.focus();
+      throw new Error('Give this voice a name.');
+    }
+    const profile = { name: voiceName || 'Voice preview', type: method() };
+    if (profile.type === 'design') {
+      const details = description.value.trim();
+      if (!details) {
+        description.focus();
+        throw new Error('Describe the voice you want to hear.');
+      }
+      return { ...profile, description: details };
+    }
+    if (profile.type === 'blend') {
+      if (voiceA.value === voiceB.value) {
+        voiceB.focus();
+        throw new Error('Choose two different voices to blend.');
+      }
+      return { ...profile, voiceA: voiceA.value, voiceB: voiceB.value, ratio: Number(ratio.value) / 100 };
+    }
+    if (!reference) {
+      file.focus();
+      throw new Error('Choose a recording before continuing.');
+    }
+    if (!ownVoice.checked) {
+      ownVoice.focus();
+      throw new Error('Confirm that the recording is of your own voice.');
+    }
+    return { ...profile, reference };
+  }
+
+  function clearDraftPreview() {
+    stopPreview(true);
+    setStatus('');
+  }
+
+  form.addEventListener('input', (event) => {
+    if (event.target === file || event.target === name) return;
+    if (event.target.name === 'voice-method') {
+      for (const panel of methodPanels) panel.hidden = panel.dataset.method !== method();
+      updateBusy(false, false);
+    }
+    if (event.target === ratio) {
+      const second = Number(ratio.value);
+      mix.value = `${100 - second}% / ${second}%`;
+      ratio.setAttribute('aria-valuetext', `${100 - second}% first voice and ${second}% second voice`);
+    }
+    clearDraftPreview();
+  });
+
+  file.addEventListener('change', async () => {
+    const version = ++fileVersion;
+    reference = undefined;
+    ownVoice.checked = false;
+    clearDraftPreview();
+    const selected = file.files[0];
+    decoding = Boolean(selected);
+    fileStatus.textContent = selected ? 'Reading recordingâ€¦' : '';
+    fileStatus.dataset.tone = 'neutral';
+    updateBusy(busy, !cancel.hidden);
+    if (!selected) return;
+    try {
+      const samples = await decodeReference(selected);
+      if (version !== fileVersion) return;
+      reference = samples;
+      fileStatus.textContent = `${(samples.length / SAMPLE_RATE).toFixed(1)} seconds of audio ready.`;
+    } catch (error) {
+      if (version !== fileVersion) return;
+      fileStatus.textContent = error.message;
+      fileStatus.dataset.tone = 'error';
+    } finally {
+      if (version === fileVersion) {
+        decoding = false;
+        updateBusy(busy, !cancel.hidden);
+      }
+    }
+  });
+
+  preview.addEventListener('click', () => {
+    try {
+      const profile = draft({ requireName: false });
+      stopPreview(true);
+      onPreview(profile);
+    } catch (error) {
+      setStatus(error.message, 'error');
+    }
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (busy || (method() === 'clone' && decoding)) return;
+    try {
+      const profile = draft({ requireName: true });
+      updateBusy(true, false);
+      await initialized;
+      if (profiles.length >= PROFILE_LIMIT) throw new Error('You can save up to 12 voices. Delete one before adding another.');
+      if (profiles.some((saved) => saved.name.toLocaleLowerCase() === profile.name.toLocaleLowerCase())) {
+        throw new Error('A saved voice already uses that name.');
+      }
+      const record = { ...profile, id: crypto.randomUUID(), createdAt: Date.now(), persisted: true };
+      try {
+        await storeProfile(record);
+      } catch {
+        record.persisted = false;
+      }
+      profiles = [record, ...profiles];
+      renderProfiles();
+      setStatus(record.persisted ? 'Voice saved. Choose Use to open it in the Studio.' : 'Voice added for this session. Browser storage is unavailable.', 'success');
+    } catch (error) {
+      setStatus(error.message, 'error');
+    } finally {
+      updateBusy(false, false);
+    }
+  });
+
+  cancel.addEventListener('click', onCancel);
+  return { getProfile, setStatus, updateProgress, updateBusy, stopPreview, showPreview };
+}
