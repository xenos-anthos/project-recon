@@ -0,0 +1,89 @@
+import { generatePocket, initializePocket } from "./engines/clone/pocket-runtime.js";
+
+const SAMPLE_RATE = 24_000;
+const MIN_REFERENCE_SECONDS = 3;
+const MAX_REFERENCE_SECONDS = 10;
+// Model graphs and tokenizer, the assets reported by the download callback.
+const DOWNLOAD_BYTES = 146_215_025;
+const options = {
+  language: "english_2026-04",
+  voiceCloning: true,
+  quantized: true,
+  cache: true,
+  cacheName: "anthos-pocket-tts-english-v1",
+  maxThreads: 2,
+  modelBaseUrl: "https://huggingface.co/vlapky/pocket-tts-onnx/resolve/c469236dbc5f68287fa2fbf175b66de3b80123af/onnx",
+  ortBaseUrl: "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.20.0/dist/",
+};
+
+let modelPromise;
+
+function loadModel(progress) {
+  if (modelPromise) return modelPromise;
+  const downloaded = new Map();
+  let reported = 0;
+  progress("Loading the reference voice engineâ€¦", 0);
+  modelPromise = initializePocket(options, (event) => {
+    if (event.type !== "progress") return;
+    downloaded.set(event.label, event.loaded);
+    const total = Array.from(downloaded.values()).reduce((sum, bytes) => sum + bytes, 0);
+    const fraction = Math.min(1, total / DOWNLOAD_BYTES);
+    const percent = Math.floor(fraction * 70);
+    if (percent <= reported) return;
+    reported = percent;
+    const action = event.fromCache ? "Loading" : "Downloading";
+    progress(`${action} Pocket TTS (${Math.round(fraction * 100)}%)â€¦`, percent);
+  }).catch((error) => {
+    modelPromise = undefined;
+    throw new Error("Could not load Pocket TTS. Check your connection and try again.", { cause: error });
+  });
+  return modelPromise;
+}
+
+function getReferenceAudio(reference) {
+  const samples = reference instanceof Float32Array ? reference : reference?.samples;
+  const rate = reference instanceof Float32Array ? SAMPLE_RATE : reference?.sampleRate;
+  if (!(samples instanceof Float32Array) || rate !== SAMPLE_RATE) {
+    throw new Error("Choose a reference recording that this browser can decode.");
+  }
+  if (samples.length < MIN_REFERENCE_SECONDS * SAMPLE_RATE) {
+    throw new Error("Choose a recording with at least three seconds of clear speech.");
+  }
+  const excerpt = samples.subarray(0, MAX_REFERENCE_SECONDS * SAMPLE_RATE);
+  let peak = 0;
+  for (const sample of excerpt) {
+    if (!Number.isFinite(sample)) throw new Error("This reference recording contains invalid audio.");
+    peak = Math.max(peak, Math.abs(sample));
+  }
+  if (peak < 0.005) throw new Error("The reference recording is too quiet. Try a clip with clear speech.");
+  return excerpt;
+}
+
+export async function synthesizeClone({ text, reference, progress = () => {} }) {
+  const excerpt = getReferenceAudio(reference);
+  const sampleRate = await loadModel(progress);
+  if (sampleRate !== SAMPLE_RATE) throw new Error("The installed reference voice model has an incompatible audio format.");
+  progress("Analyzing your reference recordingâ€¦", 74);
+
+  const chunks = [];
+  let length = 0;
+  await generatePocket(text, excerpt, (event) => {
+    if (event.type === "status" && event.status === "voice-conditioned") {
+      progress("Generating speech with your reference voiceâ€¦", 80);
+    }
+    if (event.type === "chunk") {
+      chunks.push(event.audio);
+      length += event.audio.length;
+    }
+  });
+  if (length === 0) throw new Error("Pocket TTS returned no audio. Try a shorter script or a clearer recording.");
+
+  progress("Preparing your recordingâ€¦", 98);
+  const samples = new Float32Array(length);
+  let offset = 0;
+  for (const chunk of chunks) {
+    samples.set(chunk, offset);
+    offset += chunk.length;
+  }
+  return { samples, sampleRate };
+}
