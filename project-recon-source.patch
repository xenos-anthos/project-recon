+/*! vox.js 0.19.5 â€” ÑƒÐ½Ð¸Ð²ÐµÑ€ÑÐ°Ð»ÑŒÐ½Ñ‹Ð¹ TTS-Ð´Ð²Ð¸Ð¶Ð¾Ðº vox Ð² Ð±Ñ€Ð°ÑƒÐ·ÐµÑ€Ðµ (WebGPU). Ð›Ð¸Ñ†ÐµÐ½Ð·Ð¸Ñ â€” ÐºÐ°Ðº Ñƒ Ð¿Ñ€Ð¾ÐµÐºÑ‚Ð°: https://github.com/dariumi/Vox */
+"use strict";
