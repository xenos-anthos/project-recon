+// Vox 0.19.5, pinned upstream revision 4314095151428f029c5bac36916508a1166a7518.
+// Apache-2.0 license: ./engines/design/LICENSE.txt.
+const MODEL = "hf:Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign@5ecdb67327fd37bb2e042aab12ff7391903235d3";
+const LIMIT = 500;
+const MODEL_SAMPLE_RATE = 24_000;
+
+let modelPromise;
+
+function loadModel(progress) {
+  if (!modelPromise) {
+    progress("Preparing the Qwen3 VoiceDesign engineâ€¦", 0);
+    let displayedPercent = 0;
+    modelPromise = import("./engines/design/vox.mjs")
+      .then(({ Vox }) => Vox.load(MODEL, {
+        backend: "webgpu",
+        dtype: "bf16",
+        quant: "q8",
+        cache: true,
+        load: "balanced",
+        onProgress(fraction, downloaded, total, phase) {
+          if (phase !== "weights" || !Number.isFinite(fraction) || total <= 0) return;
+          const percent = Math.floor(Math.min(1, Math.max(0, fraction)) * 70);
+          if (percent <= displayedPercent) return;
+          displayedPercent = percent;
+          const currentSize = (downloaded / 1e9).toFixed(1);
+          const fullSize = (total / 1e9).toFixed(1);
+          progress(`Loading voice model weights (${currentSize} of ${fullSize} GB)â€¦`, percent);
+        },
+      }))
+      .then((model) => {
+        if (!model.capabilities?.requires_instruct) {
+          model.dispose?.();
+          throw new Error("The loaded model does not support voice descriptions.");
+        }
+
+        // A later request can rebuild the engine if the browser releases its GPU device.
+        const active = modelPromise;
+        model.gpu?.device?.lost?.then(() => {
+          if (modelPromise === active) modelPromise = undefined;
+        });
+        return model;
+      })
+      .catch((cause) => {
+        modelPromise = undefined;
+        if (cause.code === "no-webgpu" || cause.code === "no-adapter") {
+          throw new Error("Voice design needs a WebGPU adapter in this browser. Try Chrome or Edge on a desktop.", { cause });
+        }
+        if (cause.code === "limits" || /out of memory|device lost/i.test(cause.message)) {
+          throw new Error("The graphics device couldnâ€™t load the voice model. Close other heavy apps or use a device with more GPU memory.", { cause });
+        }
+        throw new Error("The voice design model couldnâ€™t load. Check your connection and try again.", { cause });
+      });
+  }
+  return modelPromise;
+}
+
+export async function synthesizeDesign({ text, description, progress = () => {} }) {
+  const script = typeof text === "string" ? text.trim() : "";
+  const prompt = typeof description === "string" ? description.trim() : "";
+  if (!/[\p{L}\p{N}]/u.test(script)) throw new Error("Add a script to generate the preview.");
+  if (!/[\p{L}\p{N}]/u.test(prompt)) throw new Error("Describe the voice you want to create.");
+  if (script.length > LIMIT || prompt.length > LIMIT) {
+    throw new Error("Keep the preview script and voice description within 500 characters each.");
+  }
+  if (!globalThis.navigator?.gpu) {
+    throw new Error("Voice design needs WebGPU. Try Chrome or Edge on a desktop.");
+  }
+
+  const model = await loadModel(progress);
+  const voice = model.speakerVoice("", prompt, { language: "auto" });
+
+  progress("Designing the voice and generating speechâ€¦", 72);
+  let frames = 0;
+  let reportedSeconds = 0;
+  const { pcm, sampleRate } = await model.synthesize(script, {
+    voice,
+    seed: 1,
+    onChunk(chunk) {
+      frames += chunk.length;
+      const seconds = Math.floor(frames / MODEL_SAMPLE_RATE);
+      if (seconds >= reportedSeconds + 2) {
+        reportedSeconds = seconds;
+        progress(`Generating speech (${seconds} seconds of audio)â€¦`);
+      }
+    },
+  });
+  if (!(pcm instanceof Float32Array) || !pcm.length || sampleRate !== MODEL_SAMPLE_RATE) {
+    throw new Error("The voice design model did not return usable audio. Try a shorter preview script.");
+  }
+  progress("Preparing the designed voice recordingâ€¦", 98);
+  return { samples: pcm, sampleRate };
+}
