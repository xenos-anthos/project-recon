+    let done = false;
+    while (!done) {
+        let sourceIdx = 0;
+        for (let i = 0; i < indices.length; i++) sourceIdx += indices[i] * strides[i];
+        target[targetIndex(indices)] = source.data[sourceIdx];
+        for (let dim = indices.length - 1; dim >= 0; dim--) {
+            indices[dim] += 1;
+            if (indices[dim] < maxIndices[dim]) break;
+            indices[dim] = 0;
+            if (dim === 0) done = true;
+        }
