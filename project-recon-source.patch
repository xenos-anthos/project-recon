index 0000000000000000000000000000000000000000..939212b04d15749a52a718c0a5696ee5f36ffd3b
--- /dev/null
+++ b/dist/speech-worker.js
@@ -0,0 +1,183 @@
+import { makeRecording } from "./audio-recording.js";
+
+const KOKORO_MODULE = "https://cdn.jsdelivr.net/npm/kokoro-js@1.2.1/dist/kokoro.web.js";
+const KOKORO_MODEL = "onnx-community/Kokoro-82M-v1.0-ONNX";
+const SAMPLE_RATE = 24_000;
+const SCRIPT_LIMIT = 6_000;
+const CHUNK_LIMIT = 240;
+const sentenceSegmenter = typeof Intl.Segmenter === "function"
+  ? new Intl.Segmenter("en", { granularity: "sentence" })
+  : null;
+
+let engine;
+let busy = false;
+
+function progress(id, message, percent) {
+  self.postMessage({ id, type: "progress", message, percent });
+}
+
+function loadEngine(id) {
+  if (engine) return engine;
+
+  progress(id, "Loading the voice engineâ€¦", 0);
+  let lastPercent = 0;
+  engine = import(KOKORO_MODULE)
+    .then(({ KokoroTTS }) => KokoroTTS.from_pretrained(KOKORO_MODEL, {
+      device: "wasm",
+      dtype: "q8",
+      progress_callback(event) {
+        if (event.status !== "progress" || !event.file?.endsWith(".onnx") || !Number.isFinite(event.progress)) {
+          return;
+        }
+        const download = Math.max(0, Math.min(100, Math.round(event.progress)));
+        const percent = Math.round(download * 0.7);
+        if (percent > lastPercent) {
+          lastPercent = percent;
+          progress(id, `Downloading the voice model (${download}%)â€¦`, percent);
+        }
+      },
+    }))
+    .catch((error) => {
+      engine = undefined;
+      throw new Error("The voice engine couldnâ€™t load. Check your connection and try again.", { cause: error });
+    });
+  return engine;
+}
+
+function isBlend(voice) {
+  return voice?.type === "blend"
+    && typeof voice.voiceA === "string" && voice.voiceA.trim().length > 0
+    && typeof voice.voiceB === "string" && voice.voiceB.trim().length > 0
+    && Number.isFinite(voice.ratio) && voice.ratio >= 0 && voice.ratio <= 1;
+}
+
+function createVoiceSynthesizer(tts, voice, speed) {
+  if (typeof voice === "string") return (text) => tts.generate(text, { voice, speed });
+
+  const { voiceA, voiceB, ratio } = voice;
+  if (voiceA === voiceB || ratio === 0 || ratio === 1) {
+    const preset = ratio === 1 ? voiceB : voiceA;
+    return (text) => tts.generate(text, { voice: preset, speed });
+  }
+
+  // Keep Kokoro's phonemization and per-token voice vectors. These isolated
+  // adapters intercept the model call from kokoro-js 1.2.1 to combine both
+  // vectors before one inference, with the phonemes selected by voice A.
+  const first = Object.create(tts);
+  first.model = async (inputs) => {
+    const second = Object.create(tts);
+    let output;
+    second.model = async ({ style }) => {
+      const mixed = inputs.style.data;
+      const other = style.data;
+      if (!mixed.length || mixed.length !== other.length) {
+        throw new Error("The two voice profiles are incompatible.");
+      }
+      for (let index = 0; index < mixed.length; index += 1) {
+        mixed[index] = mixed[index] * (1 - ratio) + other[index] * ratio;
+      }
+      output = await tts.model(inputs);
+      return output;
+    };
+    await second.generate_from_ids(inputs.input_ids, { voice: voiceB, speed });
+    return output;
+  };
+  return (text) => first.generate(text, { voice: voiceA, speed });
+}
+
+function divideSentence(text) {
+  const parts = [];
+  let remaining = text.trim().replace(/\s+/g, " ");
+  while (remaining.length > CHUNK_LIMIT) {
+    let end = remaining.lastIndexOf(" ", CHUNK_LIMIT);
+    if (end < 1) {
+      end = CHUNK_LIMIT;
+      // Preserve surrogate pairs when a long word has no space to break on.
+      const codeUnit = remaining.charCodeAt(end);
+      if (codeUnit >= 0xDC00 && codeUnit <= 0xDFFF) end -= 1;
+    }
+    parts.push(remaining.slice(0, end));
+    remaining = remaining.slice(end).trimStart();
+  }
+  if (remaining) parts.push(remaining);
+  return parts;
+}
+
+function divideScript(text) {
+  const chunks = [];
+  for (const paragraph of text.split(/\r?\n\s*\r?\n/u)) {
+    if (!paragraph.trim()) continue;
+    const sentences = sentenceSegmenter
+      ? Array.from(sentenceSegmenter.segment(paragraph), ({ segment }) => segment)
+      : paragraph.split(/(?<=[.!?])\s+/u);
+    let pending = "";
+    for (const piece of sentences.flatMap(divideSentence)) {
+      if (pending && pending.length + piece.length + 1 > CHUNK_LIMIT) {
+        chunks.push({ text: pending, pause: 0.05 });
+        pending = "";
+      }
+      pending = pending ? `${pending} ${piece}` : piece;
+    }
+    if (pending) chunks.push({ text: pending, pause: 0.16 });
+  }
+  if (chunks.length) chunks[chunks.length - 1].pause = 0;
+  return chunks;
+}
+
+self.addEventListener("message", async ({ data }) => {
+  const { id, text, voice, speed = 1 } = data ?? {};
+  const sendError = (message, reloadEngine = false) => {
+    self.postMessage({ id, type: "error", message, reloadEngine });
+  };
+
+  if (busy) {
+    sendError("Another recording is already being generated.");
+    return;
+  }
+  if (typeof text !== "string" || !/[\p{L}\p{N}]/u.test(text)) {
+    sendError("Add some text to generate speech.");
+    return;
