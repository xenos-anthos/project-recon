+  const size = bytes.byteLength;
+  if (size <= WAV_HEADER_BYTES || size % 2) throw new RequestError('A playable WAV is required.');
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  // Accept the canonical RIFF layout emitted by the studio.
+  if (view.getUint32(0) !== 0x52494646 || view.getUint32(4, true) !== size - 8 ||
+      view.getUint32(8) !== 0x57415645 || view.getUint32(12) !== 0x666d7420 ||
+      view.getUint32(16, true) !== 16 || view.getUint16(20, true) !== 1 ||
+      view.getUint16(22, true) !== 1 || view.getUint32(24, true) !== SAMPLE_RATE ||
+      view.getUint32(28, true) !== SAMPLE_RATE * 2 || view.getUint16(32, true) !== 2 ||
+      view.getUint16(34, true) !== 16 || view.getUint32(36) !== 0x64617461 ||
+      view.getUint32(40, true) !== size - WAV_HEADER_BYTES) {
+    throw new RequestError('Choose a 24 kHz mono WAV generated by Project Recon.');
+  }
+  return (size - WAV_HEADER_BYTES) / (SAMPLE_RATE * 2);
+}
+
+function soundRecord(object, prefix) {
+  const metadata = object.customMetadata;
+  return {
+    id: object.key.slice(prefix.length),
+    title: metadata.title,
+    voiceLabel: metadata.voiceLabel,
+    createdAt: Number(metadata.createdAt),
+    duration: Number(metadata.duration),
+    speed: Number(metadata.speed),
+    bytes: object.size,
+  };
+}
+
+async function listSounds(bucket, prefix, url) {
+  const cursor = url.searchParams.get('cursor') || undefined;
+  if (cursor?.length > 1024) throw new RequestError('Invalid sounds page.');
+  const page = await bucket.list({ prefix, limit: PAGE_SIZE, cursor, include: ['customMetadata'] });
+  const sounds = page.objects
+    .filter((object) => object.customMetadata && SOUND_ID.test(object.key.slice(prefix.length)))
+    .map((object) => soundRecord(object, prefix))
+    .sort((first, second) => second.createdAt - first.createdAt);
+  return json({ sounds, ...(page.truncated && page.cursor ? { nextCursor: page.cursor } : {}) });
+}
+
+async function putSound(bucket, prefix, key, request) {
+  const metadata = readMetadata(request);
+  const bytes = await readSoundBody(request);
+  metadata.duration = String(wavDuration(bytes));
+  const saved = await bucket.put(key, bytes, {
+    onlyIf: new Headers({ 'If-None-Match': '*' }),
+    httpMetadata: { contentType: 'audio/wav', cacheControl: PRIVATE_HEADERS['Cache-Control'] },
+    customMetadata: metadata,
+  });
+  // If the network loses the first response, a retry returns the already saved sound.
+  const existing = saved || await bucket.head(key);
+  if (!existing) throw new RequestError('The sound changed during the upload. Try again.', 409);
+  return json({ sound: soundRecord(existing, prefix) }, saved ? 201 : 200);
+}
+
+export async function serveApi(request, env) {
+  const url = new URL(request.url);
+  if (!url.pathname.startsWith('/api/')) return null;
+
+  const subject = authenticatedSubject(request);
+  if (url.pathname === '/api/account') {
+    return request.method === 'GET'
+      ? json({ authenticated: Boolean(subject) })
+      : json({ error: 'Method not allowed.' }, 405, { Allow: 'GET' });
+  }
+
+  const library = url.pathname === '/api/sounds';
+  const soundId = url.pathname.match(/^\/api\/sounds\/([^/]+)$/)?.[1];
+  if (!library && (!soundId || !SOUND_ID.test(soundId))) return json({ error: 'Sound not found.' }, 404);
+  if (!subject) return json({ error: 'Sign in to access saved sounds.' }, 401);
+  if (library ? request.method !== 'GET' : !['GET', 'PUT', 'DELETE'].includes(request.method)) {
+    return json({ error: 'Method not allowed.' }, 405, { Allow: library ? 'GET' : 'GET, PUT, DELETE' });
+  }
+  if (request.method !== 'GET' && !sameOrigin(request, url)) {
+    return json({ error: 'This request must come from Project Recon.' }, 403);
+  }
+  const bucket = env?.RECON_SOUNDS;
+  if (!bucket) return json({ error: 'Cloud storage is unavailable.' }, 503);
+
+  try {
+    const prefix = await soundsPrefix(subject);
+    if (library) return await listSounds(bucket, prefix, url);
+    const key = prefix + soundId;
+    if (request.method === 'PUT') return await putSound(bucket, prefix, key, request);
+    if (request.method === 'DELETE') {
+      await bucket.delete(key);
+      return new Response(null, { status: 204, headers: PRIVATE_HEADERS });
+    }
+    const sound = await bucket.get(key);
+    if (!sound) return json({ error: 'Sound not found.' }, 404);
+    return new Response(sound.body, {
+      headers: {
+        ...PRIVATE_HEADERS,
+        'Content-Type': 'audio/wav',
+        'Content-Length': String(sound.size),
+      },
+    });
+  } catch (error) {
+    if (error instanceof RequestError) return json({ error: error.message }, error.status);
+    return json({ error: 'Cloud storage is unavailable. Try again.' }, 503);
+  }
+}
